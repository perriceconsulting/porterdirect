node_modules/
dist/
*.tsbuildinfo
.env
.env.local
.env.*.local
# Never commit a secrets sidecar — untracked is NOT ignored otherwise (see CLAUDE.md).
# `*.env.bak` alone does NOT match `.env.local.bak`, which is the name the standard warns about.
*.env.bak
.env*.bak*
.env*.backup*
.env*.orig
.env*.save
.DS_Store
*.log
coverage/
.next/

# Playwright run output — regenerated every run, never source.
test-results/
playwright-report/

# ---- Credentials and sensitive material --------------------------------
# Belt and braces. The rules above already cover this repo's own secrets file;
# these cover the things that arrive later — a cert, a service-account JSON, an
# editor backup — and that nobody thinks to add a rule for until after the push.
*.pem
*.key
*.crt
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
*.ppk

# Cloud / provider credential files
.npmrc
.netrc
auth.json
service-account*.json
*credentials*.json
*-serviceaccount.json
.aws/
.gcloud/
.vercel/

# Anything explicitly named as a secret
secrets/
.secrets/
*.secret
*.secrets

# Editor and tool backups — these are how a secrets file gets a second life
# under a name no .env rule matches.
*.bak
*.orig
*.rej
*.swp
*~

.vercel
# Vercel CLI appends `.env*`, which also shadows the tracked env CONTRACT. It stays
# tracked because it holds no values — but an ignore rule that appears to cover it
# invites someone to "helpfully" delete it, or to miss that it is the canonical contract.
.env*
!.env.example

# Local HTTPS certificates for real-device testing on a LAN address.
# A PRIVATE KEY lives here. Untracked is not enough — an unignored file goes in with the
# next `git add -A`, which is precisely how a .env.local.bak reaches a remote.
certificates/
**/certificates/
*.pem
