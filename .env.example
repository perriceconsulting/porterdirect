# PorterDirect platform — environment contract.
# FORMAT RULE: write KEY=value with NO space after '=' and NO trailing inline
# comment. `KEY= value` makes a shell that sources this file assign an empty
# string and then EXECUTE the value — which prints the credential into the
# terminal and any transcript. Put comments on their own line above the key.
# scripts/lib/load-env.sh parses this safely; never `.` or `source` it.
# Copy to .env.local (gitignored) and fill with TEST-MODE values only during dev.
# See CLAUDE.md "Third-party sandboxes" for the account-hygiene rules these enforce.

# --- Stripe (licensee subscription billing) ---
# TEST MODE ONLY in dev. scripts/guard-stripe-env.sh refuses non-test secret keys.
STRIPE_SECRET_KEY=sk_test_xxx
# must come from the SAME account as the secret key
STRIPE_PUBLISHABLE_KEY=pk_test_xxx
# re-derive PER ACCOUNT; never carry over
STRIPE_WEBHOOK_SECRET=whsec_xxx

# Stripe Tax calculation. Requires a head office address and registrations in the
# Stripe dashboard. Leave false until those exist; the app REFUSES to run a live
# key with this off, because charging real customers with no tax is a compliance
# problem rather than a smaller feature.
STRIPE_AUTOMATIC_TAX=false

# Stripe Price IDs mirror the canonical plan catalog in packages/billing/src/plans.ts.
# These are per-account and DO NOT transfer between accounts. Each tier Price is a
# GRADUATED per-seat recurring Price (see plans.ts); the subscription quantity is the
# total active seats. `npm run verify:catalog` checks catalog invariants now; the
# Stripe-API reconciler asserts these match once a test key is present.
# See docs/stripe-dev-setup.md for how to create each Price.
# graduated: $199 up to 5 seats, then $25/seat
STRIPE_PRICE_DIRECT_COURIER=price_xxx
# graduated: $499 up to 15 seats, then $25/seat
STRIPE_PRICE_FLEET_FREIGHT=price_xxx
# graduated: $999 up to 50 seats, then $25/seat
STRIPE_PRICE_WHITE_LABEL_AGENCY=price_xxx
# one-time, agency onboarding ($1,500)
STRIPE_PRICE_SETUP_FEE_AGENCY=price_xxx
# one-time add-on ($499)
STRIPE_PRICE_APP_STORE_DEPLOY=price_xxx
# metered usage add-on (pass-through + 20%)
STRIPE_PRICE_SMS_METERED=price_xxx

# --- Auth (Better Auth) ---
# Signing secret, 32+ chars. Rotating it invalidates every live session by design.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=
# Public origin this instance is served on, e.g. https://porterdirect.com
BETTER_AUTH_URL=http://localhost:3000

# --- Database (Neon Postgres) ---
DATABASE_URL=postgres://user:pass@host/db?sslmode=require
