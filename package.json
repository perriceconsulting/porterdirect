{
  "name": "porterdirect",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Multi-tenant, white-label logistics SaaS platform (courier + freight modules).",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/db packages/billing packages/auth packages/orders packages/contact && tsc --noEmit -p apps/marketing/tsconfig.json",
    "verify:catalog": "vitest run packages/billing/test/plans.test.ts",
    "guard:stripe": "bash scripts/guard-stripe-env.sh",
    "stripe:doctor": "bash scripts/stripe-doctor.sh",
    "dev": "npm run dev -w @porterdirect/marketing",
    "stripe:listen": "bash scripts/stripe-listen.sh",
    "stripe:prices": "tsx scripts/stripe-create-prices.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "verify:conventions": "bash scripts/verify-conventions.sh",
    "verify": "npm run typecheck && npm run lint && npm run verify:conventions && npm test",
    "phast": "playwright test --project=phast",
    "phast:serial": "npm run phast -- --workers=1",
    "e2e": "playwright test --project=e2e",
    "e2e:headed": "npm run e2e -- --headed --workers=1",
    "seed:demo": "tsx scripts/seed-demo-jobs.ts"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@playwright/test": "^1.63.0",
    "@porterdirect/db": "*",
    "@types/node": "^20.17.0",
    "eslint": "^9.39.5",
    "tsx": "^4.23.13",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "libphonenumber-js": "^1.13.12"
  }
}
